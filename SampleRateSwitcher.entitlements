<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- The EQ reads Apple Music's process tap through an aggregate device's
         input. macOS treats that as audio input, and under the hardened
         runtime it is denied outright (no prompt) without this entitlement:
         the tap then delivers silence while Music stays muted. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
